# ARISE — environment configuration
# Copy this file to `.env` and fill in the values you need, then restart the dashboard.
# `.env` is git-ignored and never committed.

# ── AI providers (set the key for the provider(s) you want to use) ────────────
# Claude (Anthropic)
ANTHROPIC_API_KEY=
# OpenAI
OPENAI_API_KEY=
# Google Gemini (GOOGLE_API_KEY is also accepted)
GEMINI_API_KEY=
# Hugging Face (HUGGINGFACE_API_KEY / HUGGINGFACEHUB_API_TOKEN also accepted)
HF_API_TOKEN=

# ── Slack (for automated + manual AI summaries) ──────────────────────────────
# Incoming Webhook URL: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=

# ── AI defaults (also editable in the dashboard Settings panel) ──────────────
# Default provider: claude | openai | gemini | huggingface
ARISE_AI_PROVIDER=claude
# Default Claude model (per-provider overrides: OPENAI_MODEL, GEMINI_MODEL, HF_MODEL)
ARISE_AI_MODEL=claude-opus-4-8
# OPENAI_MODEL=gpt-4o
# GEMINI_MODEL=gemini-1.5-flash
# HF_MODEL=meta-llama/Llama-3.1-8B-Instruct

# Auto-post an AI summary to Slack when a scan completes (true/false)
ARISE_AUTO_SLACK=true
# How often (seconds) the dashboard checks for newly completed scans
ARISE_AI_WATCH_INTERVAL=20

# ── Dashboard ────────────────────────────────────────────────────────────────
ARISE_DASHBOARD_PORT=5000

# ── Authentication & secure storage ──────────────────────────────────────────
# The dashboard now requires login. On first run an admin account is created:
#   - set ARISE_ADMIN_USER / ARISE_ADMIN_PASSWORD to choose the credentials, or
#   - leave them blank and a random password is printed to the console ONCE.
# You can change the password later from the dashboard Settings panel.
ARISE_ADMIN_USER=admin
ARISE_ADMIN_PASSWORD=

# Flask session signing key. Leave blank to auto-generate and persist to
# arise_session.key (git-ignored). Set explicitly to share sessions across hosts.
SECRET_KEY=

# Fernet master key that encrypts the API-key vault (secrets.enc.json).
# Leave blank to auto-generate and persist to .arise_master.key (chmod 600,
# git-ignored). BACK THIS UP — without it, stored API keys cannot be decrypted.
ARISE_MASTER_KEY=

# Set to true when the dashboard is served over HTTPS (e.g. behind Cloudflare /
# a TLS reverse proxy) so the session cookie gets the Secure flag.
ARISE_COOKIE_SECURE=false

# ── OSINT & Human Exposure Intelligence (Module 18 — osint_intel.py) ──────────
# All collectors are passive/public. These optional keys light up the keyed
# breach/dark-web and code-exposure feeds; without them those channels report
# "not configured" and the free feeds (crt.sh CT logs, dnstwist typosquats,
# Shodan InternetDB) still run. Set ARISE_OSINT_OFFLINE=true to disable ALL
# network calls (fully offline correlation over on-disk recon only).
ARISE_OSINT_OFFLINE=false
# Have I Been Pwned — domain-wide breach search (paid API key).
HIBP_API_KEY=
# Intelligence X — paste/leak index monitoring.
INTELX_API_KEY=
# LeakCheck — credential-exposure monitoring.
LEAKCHECK_API_KEY=
# GitHub token — public code / leaked-secret search (classic or fine-grained,
# read-only / public_repo scope is sufficient). GITHUB_API_TOKEN also accepted.
GITHUB_TOKEN=
# Shodan full API key (optional; the free InternetDB endpoint needs no key).
SHODAN_API_KEY=
