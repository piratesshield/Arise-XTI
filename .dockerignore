# ── ARISE Docker build-context excludes ──────────────────────────────────────
# Keep scan data, secrets, caches, and dev artifacts OUT of the image.

# Scan data / outputs — mount as a volume at runtime
scans/
outputs/
logs/
jobs/
state/

# Secrets & per-install identity — NEVER bake into an image
.env
.env.*
*.key
.arise_master.key
arise_session.key
users.json
secrets.enc.json
.arise_kev_cache.json

# VCS / editor / OS
.git/
.gitignore
.claude/
.agents/
.DS_Store
**/__pycache__/
**/*.pyc
**/*.pyo

# Local Python / node envs
venv/
.venv/
.venv-*/
env/
node_modules/

# Dev / scratch files
dash-exam/
screenshots/
*.fig
*.backups.py
old_filter.txt
test_filter.js
filter_manager.js
qq1.png
apitarget.txt
dashboard_5000.log
docker/*.tar

# Docs (README is excluded via *.md below; keep capec_v3.9 data)
*.md
!capec_v3.9/**/*.md

# Test fixtures (large snapshot data)
tests/fixtures/
tests/ai_evals/

# Roadmap / planning files
*.ROADMAP.md
*.RESEARCH.md
